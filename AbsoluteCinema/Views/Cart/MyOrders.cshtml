@using DataAccessLayer.Entities
@model IEnumerable<OrderModel>

<h2 class="mb-4">My Orders</h2>

@if (!Model.Any())
{
    <p>You have no orders yet.</p>
}
else
{
    @foreach (var order in Model)
    {
        <div class="card mb-4 shadow-sm">

            <!-- 🧾 Order Header -->
            <div class="card-header d-flex justify-content-between">
                <div>
                    <strong>Order #@order.OrderId</strong><br />
                    <small>@order.OrderDate.ToString("g")</small>
                </div>

                <div>
                    <span class="badge bg-info">@order.OrderStatus</span><br />
                    <strong>@order.TotalAmount.ToString("C")</strong>
                </div>
            </div>

            <!-- 📦 Items -->
            <div class="card-body">

                @foreach (var item in order.OrderItems)
                {
                    <div class="d-flex justify-content-between border-bottom py-2">

                        <div>
                            <strong>@item.Product.Name</strong><br />
                            <small>Qty: @item.Quantity</small>
                        </div>

                        <div>
                            @((item.Quantity * item.PurchasePrice).ToString("C"))
                        </div>

                    </div>
                }

                <!-- 🚚 Extra Info -->
                <div class="mt-3">
                    <p><strong>Shipping:</strong> @order.ShippingAddress</p>
                    <p><strong>Tracking #:</strong> @order.TrackingNumber</p>
                    <p><strong>Estimated Delivery:</strong> @order.ShippingDate.ToShortDateString()</p>
                </div>

            </div>

        </div>
    }
}
