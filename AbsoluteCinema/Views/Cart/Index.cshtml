@model DataAccessLayer.Entities.CartModel

@{
    ViewData["Title"] = "Shopping Cart";

    var items = Model?.CartItems ?? new List<DataAccessLayer.Entities.CartItemModel>();
    decimal subtotal = items.Sum(i => i.Product.Price * i.Quantity);

    decimal taxRate = 0.10m;
    decimal taxAmount = subtotal * taxRate;

    decimal shipping = subtotal > 100 ? 0 : 10;

    decimal discountRate = Model?.PromoCode != null
        ? Model.PromoCode.DiscountPercentage / 100
        : 0;

    decimal discountAmount = subtotal * discountRate;

    decimal total = subtotal + taxAmount + shipping - discountAmount;
}

<div class="cart-container">
    <h2>🛒 Your Shopping Cart</h2>

    @if (!items.Any())
    {
        <div class="empty-cart">
            <p>Your cart is empty.</p>
            <a asp-controller="Product" asp-action="Index" class="btn-primary">
                Continue Shopping
            </a>
        </div>
    }
    else
    {
        <div class="cart-content">

            <!-- Cart Items -->
            <div class="cart-items">
                <table>
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td class="product-info">
                                    <img src="@item.Product.ImagePath" alt="@item.Product.Name" />
                                    <span>@item.Product.Name</span>
                                </td>

                                <td>
                                    @item.Product.Price.ToString("C")
                                </td>

                                <td>
                                    <div class="qty-wrapper">

                                        <!-- MINUS -->
                                        <form asp-action="UpdateQuantity" method="post">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                            <button type="submit" class="qty-btn minus">–</button>
                                        </form>

                                        <span class="qty-value">@item.Quantity</span>

                                        <!-- PLUS -->
                                        <form asp-action="UpdateQuantity" method="post">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                            <button type="submit" class="qty-btn plus">+</button>
                                        </form>

                                    </div>
                                </td>

                                <td>
                                    @((item.Product.Price * item.Quantity).ToString("C"))
                                </td>

                                <td>
                                    <form asp-action="RemoveFromCart" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn-danger">
                                            Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <!----Promo code---->
            <div class="promo-section">
            

               
                @if (Model?.PromoCode == null)
                {
                    <form asp-action="ApplyPromo" method="post">
                        <input type="text"
                               name="code"
                               placeholder="Enter promo code"
                               class="promo-input" />
                        <button type="submit" class="btn-promo">
                            Apply
                        </button>
                    </form>
                        @if (TempData["PromoError"] != null)
                            {
                              <div class="alert alert-danger">
                                @TempData["PromoError"]
                               </div>
                            }

                    
                }
                else
                {
                    <div class="applied-promo">
                        <p>
                            🎟 Promo Applied:
                            <strong>@Model.PromoCode.Code</strong>
                            (@Model.PromoCode.DiscountPercentage% off)
                        </p>

                        <form asp-action="RemovePromo" method="post">
                            <button type="submit" class="btn-remove-promo">
                                Remove Promo
                            </button>
                        </form>
                    </div>
                }

            </div>

            <!-- Summary -->
            <div class="cart-summary">
                <h3>Order Summary</h3>

                <div class="summary-row">
                    <span>Subtotal:</span>
                    <span>@subtotal.ToString("C")</span>
                </div>

                <div class="summary-row">
                    <span>Tax (10%):</span>
                    <span>@taxAmount.ToString("C")</span>
                </div>

                <div class="summary-row">
                    <span>Shipping:</span>
                    <span>
                        @(shipping == 0 ? "Free" : shipping.ToString("C"))
                    </span>
                </div>

                @if (Model?.PromoCode != null)
                {
                    <div class="summary-row discount">
                        <span>Discount (@Model.PromoCode.DiscountPercentage%):</span>
                        <span>-@discountAmount.ToString("C")</span>
                    </div>
                }

                <div class="summary-row total">
                    <span>Total:</span>
                    <span>@total.ToString("C")</span>
                </div>

                <a asp-controller="Checkout" asp-action="Index"
                   class="btn-checkout">
                    Proceed to Checkout
                </a>
            </div>

        </div>
    }
</div>