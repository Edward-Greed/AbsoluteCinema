@model AbsoluteCinema.Models.ProductDetailsViewModel

<a asp-action="Index" class="back-btn">
    &larr; Back to Products
</a>

<div class="product-detail-container">
    <div class="product-main">
        <div class="product-image-section">
            <img src="@Model.Product.ImagePath" alt="@Model.Product.Name" />
        </div>

        <div class="product-information-section">
            <h1 class="product-title">
                @Model.Product.Name
            </h1>

            <p class="product-description">
                @Model.Product.Description
            </p>

            <p class="product-price">
                @Model.Product.Price.ToString("C")
            </p>

            <p class="product-qty-available">
                Qty Available: @Model.Product.QuantityAvailable
            </p>

            <form asp-action="AddToCart" method="post">
                <input type="hidden" name="productId" value="@Model.Product.ProductId" />
                <button type="submit" class="add-btn">
                    Add to Cart
                </button>
            </form>
        </div>

    </div>

    <hr />

    <h3 class="promotion">Related Products</h3>

    <div class="related-grid">
        @foreach (var item in Model.RelatedProducts)
        {
            <div class="related-card">
                <a asp-action="Details" asp-route-id="@item.ProductId">
                    <img src="@item.ImagePath" />
                    <p>@item.Name</p>
                    <p>@item.Price.ToString("C")</p>
                </a>
            </div>
        }
    </div>

    <h3 class="promotion"> Want to watch something similar?</h3>

    <div class="movie-grid">
    @foreach (var movie in Model.Movies)
    {
      <div class="movie-card">

          @if (movie.Poster_Path != null)
          {
                <img src="https://image.tmdb.org/t/p/w200@(movie.Poster_Path)" alt="@movie.Title" class="movie-poster"/>
          }

          <div class="movie-overlay">
              <p class="movie-title">@movie.Title</p>

                    <button type="button" class="movie-btn" onclick="openTicketModal('@movie.Title', '@movie.Poster_Path')">
                        Buy Movie Ticket
                    </button>
          </div>
      </div> 
    }
    </div>
    <div id="ticketModal" class="modal">
        <div class="modal-content">

            <span class="close" onclick="closeModal()">&times;</span>
            <h2 id="modalMovieTitle"></h2>
            <div class="screen-curve"></div>
            <div id="seatGrid" class="seat-grid"></div>

            <form asp-action="AddTicketToCart" method="post">
                <input type="hidden" name="movieTitle" id="movieTitleInput"/>
                <input type="hidden" name="posterPath" id="posterPathInput"/>
                <input type="hidden" name="seatNumber" id="seatNumberInput"/>

                <label>Theater:</label>
                <select name="theaterName" required>
                    <option value="">Select Theater</option>
                    <option value="AMC">AMC</option>
                    <option value="Regal">Regal</option>
                    <option value="Cinemark">Cinemark</option>
                </select>

                <label>Showtime:</label>
                <select name="showTime" required>
                    <option value="">Select Showtime</option>
                    <option value="12">12:00 PM</option>
                    <option value="15">3:00 PM</option>
                    <option value="18">6:00 PM</option>
                    <option value="21">9:00 PM</option>
                </select>

                <button type="submit" class="movie-btn">
                    Buy Movie Ticket
                </button>
            </form>
        </div>
      </div>

</div>
<script>
    let selectedSeat = null;

    function openTicketModal(title,posterPath) {
        document.getElementById("ticketModal").style.display = "flex";
        document.getElementById("modalMovieTitle").innerText = title;
        document.getElementById("movieTitleInput").value = title;
        document.getElementById("posterPathInput").value = posterPath;

        generateSeats();
    }
    function closeModal() {
        document.getElementById("ticketModal").style.display = "none";
    }
    function generateSeats(){
        const seatGrid = document.getElementById("seatGrid");
        seatGrid.innerHTML = "";
        const rows = 6;
        const cols = 10;

        for(let i=0; i<rows; i++){
            let rowDiv = document.createElement("div");
            rowDiv.classList.add("seat-row");

            for(let j=1; j<=cols; j++){
                let seat = document.createElement("div");
                let seatLabel = String.fromCharCode(65 + i) + j;
                seat.className = "seat";
                
                if(Math.random() < 0.3){
                    seat.classList.add("reserved");
                }
                else {
                    seat.onclick = () => selectSeat(seat, seatLabel);
                }

                rowDiv.appendChild(seat);
            }
                seatGrid.appendChild(rowDiv);
         }
    }
    function selectSeat(element, seatLabel){
            document.querySelectorAll(".seat").forEach(s => s.classList.remove("selected"));
            element.classList.add("selected");
            selectedSeat = seatLabel;
            document.getElementById("seatNumberInput").value = seatLabel;
    }

</script>

