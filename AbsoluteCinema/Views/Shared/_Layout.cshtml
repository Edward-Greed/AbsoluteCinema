<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AbsoluteCinema</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AbsoluteCinema.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body class="@ViewBag.CurrentCategory?.ToLower()">
    @using System.Security.Claims

    @{
        var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var isSeller = userIdClaim == "1";
    }
    <header>
        <nav class="navbar navbar-expand-lg custom-navbar">
            <div class="container-fluid">
                <div class="nav-left d-none d-lg-flex">
                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a class="nav-link text-dark" asp-controller="Product" asp-action="Index">Products</a>
                     <a class="nav-link text-dark" asp-controller="Cart" asp-action="MyOrders"> My Orders </a>
                </div>
                
                <a class="navbar-brand mx-auto logo" asp-controller="Home" asp-action="Index">AbsoluteCinema</a>

                <div class="nav-right d-flex align-items-center">
                    <input type="text" class="search-bar" placeholder="Search..."/>
                    <a class="nav-link cart-icon" asp-controller="Cart" asp-action="Index">🛒</a>

                    @if (User.Identity.IsAuthenticated && isSeller)
                    {
                            <a class="nav-link text-dark" asp-controller="Product" asp-action="Products">
                                Seller Panel
                            </a>
                    }

                    @if (User.Identity.IsAuthenticated)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link nav-link">➜]</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">👤</a>
                       <!--- <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>--->
                    }
                </div>
            </div>

        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AbsoluteCinema - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
