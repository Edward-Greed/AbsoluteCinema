@using DataAccessLayer.Entities
@model IEnumerable<PromoCodeModel>
@{
    ViewData["Title"] = "PromoCodes";
}

<h2>Manage Promo Codes</h2>

<a asp-action="Create" class="btn btn-success mb-3">
    Add Promo Code
</a>
<a asp-action="Products" asp-controller="Product" class="btn btn-success mb-3">

    Manage Products
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Code</th>
            <th>Discount(%)</th>
            <th>Expires</th>
            <th>Active</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Code</td>
                <td>@p.DiscountPercentage</td>
                <td>@p.ExpirationDate.ToShortDateString()</td>
                <td>@p.IsActive</td>
            </tr>
        }
    </tbody>
</table>
